<?xml version="1.0" encoding="UTF-8"?>
<bbdoc xmlns="http://brailleblaster.org/ns/bb" xmlns:bb="http://brailleblaster.org/ns/bb" xmlns:utd="http://brailleblaster.org/ns/utd"><head><bb:version>4</bb:version><utd:isNormalised>true</utd:isNormalised></head><SECTION bb:type="ROOT"><BLOCK bb:blankDocPlaceholder="true" bb:type="DEFAULT" utd:overrideStyle="Centered Heading">The Cat and the Fiddle</BLOCK><BLOCK bb:overrideOption-linesAfter="1" bb:type="DEFAULT">Hey diddle diddle</BLOCK><BLOCK bb:overrideOption-linesAfter="1" bb:type="DEFAULT">The cat and the fiddle</BLOCK><BLOCK bb:overrideOption-linesAfter="0" bb:type="DEFAULT">The cow jumped over the moon</BLOCK><BLOCK bb:overrideOption-linesAfter="1" bb:type="DEFAULT">The little dog laughed </BLOCK><BLOCK bb:overrideOption-linesAfter="1" bb:type="DEFAULT">To see such sport</BLOCK><BLOCK bb:overrideOption-linesAfter="2" bb:type="DEFAULT">And the dish ran away with the spoon.</BLOCK></SECTION></bbdoc>
